        {
          "id": "f386d0e9-c6a7-40ed-943a-57e1606b6854",
          "name": "Invoke a deployed function",
          "request": {
            "name": "Invoke a deployed function",
            "description": {
              "content": "Calls a deployed Cortex function. The JSON request body maps directly to the function's parameters. Returns a JSON object containing run_id, run_time_ms, and result. Use the function name `run` (or `predict`, or any public function defined in the app) as documented in examples. To stream output, send Accept: text/event-stream and have the function yield data; the response is a text/event-stream of `data:` lines.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v4",
                ":projectId",
                ":appName",
                ":functionName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "async",
                  "value": "<boolean>",
                  "description": "When true, the request is accepted for asynchronous execution and the call returns 202 with a run_id instead of the result."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "projectId",
                  "description": "(Required) Cerebrium project identifier, for example p-xxxxxxxx."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "appName",
                  "description": "(Required) Deployed app name from cerebrium.toml."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "functionName",
                  "description": "(Required) Public function exposed by the app (for example run or predict). Functions prefixed with an underscore are private and not callable."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key_0\": 4211.889868670573\n}",
              "options": {
                "raw": {
